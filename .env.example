# Set these in Vercel > Project > Settings > Environment Variables (NEVER commit real keys)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: force a model, otherwise auto-detected
GROQ_MODEL=
GEMINI_MODEL=
# Optional: Discord/Slack incoming-webhook URL to receive contact-form leads
LEAD_WEBHOOK_URL=
# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Telegram connector (BotFather token; secret = random 16+ chars [A-Za-z0-9_-]; slug from dashboard Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKSPACE_SLUG=
